system:
  trace_enabled: true
  # work_dir: "."           # 主程序工作目录，空则用进程 cwd；各 adapter 默认目录为 work_dir/adapters/{adapter_id}
  default_adapter: "deepseek_chat"  # 路由兜底：无 Target 且无 Tags（或标签无匹配）时投递到该 adapter

adapters:
  - id: "console_1"
    type: "console"
    enabled: true
    default_target: "deepseek_chat"  # 控制台输入的消息默认发送到deepseek_chat

  - id: "echo_service"
    type: "echo"
    enabled: true
    default_target: "console_1"      # echo适配器的回复默认发送回console

  - id: "deepseek_chat"
    type: "deepseek"
    enabled: false
    default_target: "console_1"      # deepseek的回复默认发送回console
    api_key: "YOUR_DEEPSEEK_API_KEY"
    model: "deepseek-chat"
    # base_url: "https://api.deepseek.com/v1"

  # OpenCode 适配器：工作目录默认用 adapter_dir（adapters/opencode_1），可选 workdir 覆盖；不填 base_url 时自启动
  - id: "opencode_1"
    type: "opencode"
    enabled: false
    default_target: "console_1"      # opencode的回复默认发送回console
    # workdir: "./custom"  # 可选，不填则用 adapter_dir
    # base_url: "http://localhost:3000"
    # opencode_bin: "opencode"
    # api_key: ""

  # WebChat 适配器：提供基于Web的聊天界面
  - id: "webchat"
    type: "webchat"
    enabled: true
    default_target: "echo"      # webchat的回复默认发送回echo或其他指定适配器
    port: 8080              # Web服务器端口
