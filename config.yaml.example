# MyBot 配置文件示例
# 说明：
# - 各配置项默认不注释，仅通过各块/各 adapter 的 enabled 控制是否启用
# - system.work_dir 为工作目录，主程序会为每个 adapter 注入 adapter_dir = work_dir/adapters/{adapter_id}
# - 支持文件收发的 adapter（如 opencode、lark、webchat）会使用 adapter_dir 存放上传/生成的文件
# - default_adapter：无明确目标且无标签匹配时，消息投递到该适配器
# - 各 adapter 的 default_target：该适配器「发出消息时」的默认目标；执行端「回复」应尽量回源，避免将 default_target 指回 smart_router 造成循环
# - 若希望「智能路由」：将 default_adapter 设为 smart_router 的 id，由 smart_router 按 rules 将消息转发到其他 adapter
# - 防循环：system.max_hops 限制消息最大转发跳数（默认 20）；smart_router 禁止 rule 的 target 指向自己
#
# 推荐最小配置（全能助手：Lark/Web + Smart Router + Cursor + Cron）：启用 lark、webchat、smart_router、cursor、cron；入口 default_target 指 smart_router；smart_router default_target 指 cursor；执行端不设 default_target 或仅兜底
system:
  trace_enabled: true
  work_dir: "."
  default_adapter: "smart_router_1"
  max_hops: 20
  log_level: "info"
  log_file: ""

  admin:
    enabled: false
    port: "8081"
    config_path: ""
    cron_api_urls: []
    log_path: ""

  state_store:
    enabled: false
    db_path: "./data/mybot.db"
    auto_cleanup: true
    cleanup_days: 30

  heartbeat:
    enabled: false
    interval_sec: 300
    min_interval_sec: 60
    content: ""

adapters:
  # Smart Router：作为 default_adapter 时，根据 rules 识别消息并转发到其他 adapter；target 填目标 adapter 的 GetID（如 echo.echo_service）
  - id: "smart_router_1"
    type: "smart_router"
    enabled: true
    default_target: "echo.echo_service"
    rules:
      - match_type: content_prefix
        match_value: "/code"
        target: "opencode.opencode_1"
      - match_type: content_prefix
        match_value: "/ask"
        target: "deepseek.deepseek_chat"
      - match_type: content_regex
        match_value: "(?i)bug|error|fix"
        target: "opencode.opencode_1"
      # - match_type: user_id
      #   match_value: "user_xxx"
      #   target: "deepseek.deepseek_chat"
      # - match_type: channel
      #   match_value: "channel_yyy"
      #   target: "lark.lark_bot"

  - id: "console_1"
    type: "console"
    enabled: true
    default_target: ""

  - id: "echo_service"
    type: "echo"
    enabled: true
    default_target: ""

  - id: "deepseek_chat"
    type: "deepseek"
    enabled: false
    default_target: ""
    api_key: "YOUR_DEEPSEEK_API_KEY"
    model: "deepseek-chat"
    base_url: ""

  - id: "cursor_1"
    type: "cursor"
    enabled: false
    default_target: ""
    cursor_bin: "agent"
    args: []
    heartbeat_enabled: true

  - id: "opencode_1"
    type: "opencode"
    enabled: false
    default_target: ""
    base_url: ""
    opencode_bin: "opencode"
    api_key: ""
    allow_execute: true

  - id: "public_opencode_1"
    type: "public_opencode"
    enabled: false
    base_url: ""
    default_target: ""
    api_key: ""
    opencode_bin: "opencode"
    auto_permission: ""

  - id: "lark_bot"
    type: "lark"
    enabled: false
    default_target: ""
    app_id: "YOUR_LARK_APP_ID"
    app_secret: "YOUR_LARK_APP_SECRET"
    drive_parent_node: ""

  - id: "cron_1"
    type: "cron"
    enabled: false
    default_target: ""
    cron_db_path: ""
    api_addr: ""
    api_token: ""

  - id: "webchat"
    type: "webchat"
    enabled: true
    default_target: ""
    port: 8080
